{# How the values of the resources of the site are printed (looked into before the theme's values). #}
{% block crud_site_publication_log_detail %}<pre class="max-h-[32rem] overflow-auto whitespace-pre-wrap rounded-box bg-base-200 p-3 text-xs">{{ value }}</pre>{% endblock %}

{% block crud_site_publication_status %}
    {%- set tone = {done: 'badge-success', failed: 'badge-error', pending: 'badge-ghost'}[value] ?? 'badge-info' -%}
    <span class="badge badge-sm {{ tone }}">{{ ('static_site.status.' ~ value)|trans }}</span>
{%- endblock %}

{% block crud_site_submission_status %}
    {%- set tone = {new: 'badge-info', handled: 'badge-success', spam: 'badge-ghost'}[value] ?? 'badge-ghost' -%}
    <span class="badge badge-sm {{ tone }}">{{ ('static_site.submission.' ~ value)|trans }}</span>
{%- endblock %}

{% block crud_site_submission_data_list %}
    {%- set parts = [] -%}
    {%- for field, entry in value -%}{%- set parts = parts|merge([entry is iterable ? entry|join(', ') : entry]) -%}{%- endfor -%}
    {%- set text = parts|join(' · ') -%}{{ text|length > 90 ? text|slice(0, 89) ~ '…' : text }}
{%- endblock %}

{% block crud_site_submission_data_detail %}
    <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
        {% for field, entry in value %}
            <dt class="font-medium">{{ field }}</dt>
            <dd class="whitespace-pre-wrap">{{ entry is iterable ? entry|join(', ') : entry }}</dd>
        {% endfor %}
    </dl>
{% endblock %}
